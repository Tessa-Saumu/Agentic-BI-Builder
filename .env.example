# Copy this file to .env and fill in your API keys

# LLM provider: "gemini" or "mistral"
LLM_PROVIDER="gemini"

# Required if LLM_PROVIDER=gemini (Get a free key at: https://aistudio.google.com/)
GEMINI_API_KEY="your_google_ai_studio_key_here"
GEMINI_MODEL="gemini-3.5-flash"
# Used automatically if GEMINI_MODEL is unavailable (e.g. a transient
# "high demand" / 503 error) after retrying with backoff. Optional — if
# unset, a hardcoded default fallback model is used.
GEMINI_MODEL_FALLBACK="gemini-3.1-pro"


# Required if LLM_PROVIDER=mistral (Get a key at: https://console.mistral.ai/)
MISTRAL_API_KEY="your_mistral_api_key_here"
MISTRAL_MODEL="mistral-large-latest"
# Used automatically if MISTRAL_MODEL is unavailable after retrying with
# backoff. Optional — if unset, a hardcoded default fallback model is used.
MISTRAL_MODEL_FALLBACK="mistral-medium-latest"
